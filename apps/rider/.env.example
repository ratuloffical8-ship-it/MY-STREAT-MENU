# apps/rider/.env.example
# ---------------------------------------------------------------
# MyStreetMenu Rider PWA - environment variables
# Copy this file to ".env.local" and fill in the values.
# Only NEXT_PUBLIC_* variables are visible in the browser.
# ---------------------------------------------------------------

# App
NEXT_PUBLIC_APP_NAME=MyStreetMenu Rider
NEXT_PUBLIC_DEFAULT_LANGUAGE=bn

# Backend API (leave as-is while using mock data)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# true = use built-in demo data, no backend needed
NEXT_PUBLIC_USE_MOCK_DATA=true

# Geofence: rider must be within this many metres of the customer to confirm delivery
NEXT_PUBLIC_GEOFENCE_RADIUS_METERS=100

# Dispatch / support hotline shown in Profile and Support
NEXT_PUBLIC_SUPPORT_PHONE=+8801000000000
